# Copy to .env:  cp .env.example .env
# Read by the FastAPI backend (and passed to the `api` container by docker-compose).

# --- Backend --------------------------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=college_reviews

# Use a long random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-secret-of-32-plus-chars
JWT_EXPIRES_MINUTES=60
BCRYPT_ROUNDS=12

# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000

# Per-client-IP limit for /auth/login and /auth/register.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10/minute

LOG_LEVEL=INFO

# --- Frontend -------------------------------------------------------------------------------
# The Next.js app reads frontend/.env.local (see frontend/.env.example); the defaults work locally.
