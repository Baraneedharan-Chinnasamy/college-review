{
  "info": {
    "name": "College Review System API",
    "description": "FastAPI + MongoDB College Review API.\n\n1. Run **Auth → Login as Admin / Teacher / Student** (tokens are stored automatically).\n2. Role-specific requests use `{{adminToken}}`, `{{teacherToken}}` or `{{studentToken}}`; the rest use `{{token}}` (the most recent login).\n3. **Create college** and **Create review** store `collegeId` / `reviewId` for the follow-up requests.\n\nSeeded accounts come from `npm run seed`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "teacherToken",
      "value": ""
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "collegeId",
      "value": ""
    },
    {
      "key": "reviewId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
